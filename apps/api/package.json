{
  "name": "@dakoorp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dakoorp/contracts build && node ../../scripts/check-env.mjs && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "pnpm --filter @dakoorp/contracts build && node ../../scripts/check-env.mjs && node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "@dakoorp/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
