{
  "name": "@dakoorp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dakoorp/contracts build && node --import ../../scripts/load-env.mjs --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "pnpm --filter @dakoorp/contracts build && node --import ../../scripts/load-env.mjs dist/index.js",
    "test": "pnpm --filter @dakoorp/contracts build && pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "@dakoorp/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
