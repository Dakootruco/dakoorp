{
  "name": "@dakoorp/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dakoorp/contracts build && node --import ../../scripts/load-env.mjs --import tsx src/queue.ts",
    "once": "pnpm --filter @dakoorp/contracts build && node --import ../../scripts/load-env.mjs --import tsx src/index.ts --once",
    "build": "tsc",
    "start": "pnpm --filter @dakoorp/contracts build && node --import ../../scripts/load-env.mjs dist/queue.js",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@dakoorp/contracts": "workspace:*"
  }
}
