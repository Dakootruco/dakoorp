{
  "name": "dakoorp",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @dakoorp/api dev",
    "dev:worker": "pnpm --filter @dakoorp/worker dev",
    "worker:once": "pnpm --filter @dakoorp/worker once",
    "check:env": "node scripts/check-env.mjs",
    "dev:all": "pnpm --parallel --filter web --filter @dakoorp/api --filter @dakoorp/worker dev",
    "lint": "oxlint apps packages scripts --deny-warnings",
    "test": "pnpm --filter @dakoorp/contracts test",
    "check": "pnpm lint && pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": "10.32.1"
  },
  "devDependencies": {
    "oxlint": "1.90.0"
  }
}
